# Normalize line endings on checkout; keep the wrapper scripts LF so they stay
# executable on Linux/macOS CI.
* text=auto eol=lf
*.bat text eol=crlf
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.so binary
*.keystore binary
# 插件包与 npm tarball 都是二进制 (仓库里已有后一种, 见 host-plugins/luwi-dsh-sync)
*.lwp binary
*.tgz binary
