<?xml version="1.0" encoding="utf-8"?><!--
   哪些东西不跟着 Android 12+ 的数据迁移走
   cloud-backup: 上云的自动备份 —— 凭据、会话、截图与记忆都不去
   device-transfer: 换机时的本机直传 —— 凭据不去 (新机重新登录), 会话可以带过去
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="dsh-home/.credentials.yaml" />
        <exclude domain="file" path="dsh-home/sessions" />
        <exclude domain="file" path="dsh-home/lw" />
        <exclude domain="file" path="dsh-home/memory" />
        <exclude domain="file" path="host" />
        <exclude domain="file" path="ocr" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="dsh-home/.credentials.yaml" />
        <exclude domain="file" path="dsh-home/lw" />
        <exclude domain="file" path="host" />
        <exclude domain="file" path="ocr" />
    </device-transfer>
</data-extraction-rules>
